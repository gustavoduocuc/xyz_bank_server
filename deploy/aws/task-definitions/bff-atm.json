{
  "family": "xyz-bank-bff-atm",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "networkMode": "awsvpc",
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "operatingSystemFamily": "LINUX",
    "cpuArchitecture": "X86_64"
  },
  "executionRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/xyz-bank-ecs-execution",
  "taskRoleArn": "arn:aws:iam::${AWS_ACCOUNT_ID}:role/xyz-bank-ecs-task",
  "containerDefinitions": [
    {
      "name": "bff-atm",
      "image": "${ECR_REGISTRY}/xyz-bank/bff-atm:${TAG}",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8083,
          "protocol": "tcp"
        },
        {
          "containerPort": 9083,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AUTH_TOKEN_URI",
          "value": "https://auth-server.xyz-bank.local:9000/oauth2/token"
        },
        {
          "name": "BFF_ATM_CLIENT_ID",
          "value": "bff-atm"
        },
        {
          "name": "CONFIG_SERVER_URL",
          "value": "http://config-server.xyz-bank.local:8888"
        },
        {
          "name": "CORE_SERVICE_PIN_VERIFICATION_BASE_URL",
          "value": "https://core-service.xyz-bank.local:8453"
        },
        {
          "name": "EUREKA_CLIENT_ENABLED",
          "value": "true"
        },
        {
          "name": "EUREKA_SERVER_URL",
          "value": "http://eureka-server.xyz-bank.local:8761"
        },
        {
          "name": "PLATFORM_GATEWAY_URL",
          "value": "http://api-gateway.xyz-bank.local:8090"
        },
        {
          "name": "TLS_KEYSTORE_PATH",
          "value": "file:/certs/keystore.p12"
        },
        {
          "name": "TLS_TRUSTSTORE_PATH",
          "value": "file:/certs/truststore.p12"
        },
        {
          "name": "TRACING_SAMPLING_PROBABILITY",
          "value": "0.1"
        }
      ],
      "secrets": [
        {
          "name": "BFF_ATM_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:xyz-bank/BFF_ATM_CLIENT_SECRET"
        },
        {
          "name": "BFF_ATM_SESSION_SECRET",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:xyz-bank/BFF_ATM_SESSION_SECRET"
        },
        {
          "name": "TLS_KEYSTORE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:xyz-bank/TLS_KEYSTORE_PASSWORD"
        },
        {
          "name": "TLS_TRUSTSTORE_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:${AWS_REGION}:${AWS_ACCOUNT_ID}:secret:xyz-bank/TLS_TRUSTSTORE_PASSWORD"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/xyz-bank/bff-atm",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "wget -qO- http://127.0.0.1:9083/actuator/health | grep -q UP"
        ],
        "interval": 10,
        "timeout": 5,
        "retries": 10,
        "startPeriod": 30
      }
    }
  ]
}
