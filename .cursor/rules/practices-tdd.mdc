# TPP Example in Action

```java
import org.junit.jupiter.api.Test;
import java.util.List;

import static org.junit.jupiter.api.Assertions.assertEquals;

class CalculateTotalTest {

    // Navigator (REASON):
    /*
    "List of examples to calculate total prices:
    1. Empty list
    2. List with one price
    3. List with multiple prices"
    */

    // Test 1: Empty list
    @Test
    void calculatesTotalOfEmptyPriceList() {
        List<Integer> prices = List.of();

        int total = CalculateTotal.calculateTotal(prices);

        assertEquals(0, total);
    }

    // Driver (RED): → Doesn't compile → Minimum to compile
    static class CalculateTotal {
        static int calculateTotal(List<Integer> prices) {
            return 0; // temporary just to compile
        }
    }

    // → Test passes immediately because we returned 0
    // (In Java we must return something to compile, unlike TS)

    // Navigator (REFACTOR): "All clear for now"

    // Navigator (RE-EVALUATE): "Next simplest case: one price"

    // Test 2: List with one price
    @Test
    void calculatesTotalOfSinglePrice() {
        List<Integer> prices = List.of(100);

        int total = CalculateTotal.calculateTotal(prices);

        assertEquals(100, total);
    }

    // → ❌ Test fails (0 != 100)

    // Navigator (GREEN): "(constant → scalar) - use the parameter"
    static class CalculateTotalV2 {
        static int calculateTotal(List<Integer> prices) {
            if (prices.isEmpty()) return 0;
            return prices.get(0);
        }
    }

    // Navigator (REFACTOR): "Guard clause is clear"

    // Navigator (RE-EVALUATE): "Next case: multiple prices"

    // Test 3: List with multiple prices
    @Test
    void calculatesTotalOfMultiplePrices() {
        List<Integer> prices = List.of(100, 50, 25);

        int total = CalculateTotalV3.calculateTotal(prices);

        assertEquals(175, total);
    }

    // → ❌ Test fails (100 != 175)

    // Navigator (GREEN):
    /*
    "According to TPP:
    - (if → loop)
    - or declarative approach

    In Java, Streams provide a declarative style similar to reduce"
    */
    static class CalculateTotalV3 {
        static int calculateTotal(List<Integer> prices) {
            return prices.stream()
                    .mapToInt(Integer::intValue)
                    .sum();
        }
    }

    // ✅ All tests pass

    // Navigator (REFACTOR):
    /*
    "Code is simple, expressive, and follows standards.
    Streams are idiomatic Java for this case"
    */
}
```

