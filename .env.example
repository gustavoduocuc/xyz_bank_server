# Copy to .env (`cp .env.example .env`); .env is git-ignored and must never be committed.
# Every value below is a DEVELOPMENT-ONLY value that lets a clean clone start. Replace all of
# them for any shared or Cloud environment.

# --- Image tag for xyz-bank/<service>:${TAG} (default: latest) ---
# TAG=latest

# --- Public URLs (what the browser uses). Changing AUTH_PUBLIC_ISSUER is all it takes to move
# --- the issuer; the host must appear in auth-server's certificate (see README, Cloud section)
AUTH_PUBLIC_ISSUER=https://localhost:9000
BFF_WEB_PUBLIC_URL=https://localhost:8081
BFF_MOBILE_PUBLIC_URL=https://localhost:8082

# --- Databases ---
MYSQL_ROOT_PASSWORD=dev-mysql-root-password
MYSQL_PASSWORD=dev-migration-password
CORE_DB_PASSWORD=dev-core-service-password
AUTH_DB_USERNAME=auth_server
AUTH_DB_PASSWORD=dev-auth-server-password

# --- TLS material passwords (xyzbank-dev matches scripts/generate-dev-tls-certs.sh) ---
TLS_KEYSTORE_PASSWORD=xyzbank-dev
TLS_TRUSTSTORE_PASSWORD=xyzbank-dev
AUTH_SIGNING_KEYSTORE_PASSWORD=xyzbank-dev

# --- OAuth client secrets (auth-server and the client must agree) ---
BFF_WEB_CLIENT_SECRET=dev-bff-web-client-secret
BFF_MOBILE_CLIENT_SECRET=dev-bff-mobile-client-secret
BFF_ATM_CLIENT_SECRET=dev-bff-atm-client-secret
INTERESTS_SERVICE_CLIENT_SECRET=dev-interests-service-client-secret
CUSTOMERS_ADMIN_CLIENT_SECRET=dev-customers-admin-client-secret

# --- Session and demo credentials ---
BFF_ATM_SESSION_SECRET=dev-bff-atm-session-signing-secret-replace-me-0123456789
AUTH_DEMO_PASSWORD=demo-password
