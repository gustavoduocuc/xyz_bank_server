{
  "info": {
    "name": "core-service — accounts",
    "description": "Internal, read-only accounts endpoints on core-service.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "customerId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "customerIdNoAccounts", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "accountId", "value": "33333333-3333-3333-3333-333333333333" },
    { "key": "unknownId", "value": "99999999-9999-9999-9999-999999999999" }
  ],
  "item": [
    {
      "name": "Get customer profile (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/internal/customers/{{customerId}}"
      }
    },
    {
      "name": "List accounts for customer - has accounts (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/internal/customers/{{customerId}}/accounts"
      }
    },
    {
      "name": "List accounts for customer - no accounts (200, empty array)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/internal/customers/{{customerIdNoAccounts}}/accounts"
      }
    },
    {
      "name": "Get account balance (200)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/internal/accounts/{{accountId}}/balance"
      }
    },
    {
      "name": "Get customer profile - unknown id (404 problem+json)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/internal/customers/{{unknownId}}"
      }
    },
    {
      "name": "Get account balance - unknown id (404 problem+json)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/internal/accounts/{{unknownId}}/balance"
      }
    },
    {
      "name": "Get customer profile - blank id (422 problem+json)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/internal/customers/%20%20%20"
      }
    },
    {
      "name": "KNOWN BUG - non-UUID id (currently 500, expected 422)",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/internal/customers/abc123"
      }
    }
  ]
}
