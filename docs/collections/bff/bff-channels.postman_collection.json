      "name": "bff-web",
      "description": "Web channel on https://localhost:8081. The folder's pre-request script mints a dev-signed WEB session JWT and sends it as the `session` cookie (the same cookie CallerContextInterceptor reads in the real login flow) -- see the collection description for why this stands in for a real login here.",
      "variable": [
        { "key": "baseUrl", "value": "https://localhost:8081" }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Self-contained: mints a dev-signed WEB session JWT, matching",
              "// JwtCallerContextAdapter.issue(customerId, Channel.WEB, null) exactly",
              "// (same claims, same HS256 signing secret). See the collection description.",
              "function base64url(wordArrayOrString) {",
              "  const wordArray = typeof wordArrayOrString === 'string'",
              "    ? CryptoJS.enc.Utf8.parse(wordArrayOrString)",
              "    : wordArrayOrString;",
              "  return CryptoJS.enc.Base64.stringify(wordArray)",
              "    .replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "}",
              "",
              "const secret = pm.collectionVariables.get('jwtSecret');",
              "const now = Math.floor(Date.now() / 1000);",
              "const header = { alg: 'HS256' };",
              "const payload = {",
              "  sub: pm.collectionVariables.get('customerId'),",
              "  channel: 'WEB',",
              "  scope: 'web:accounts:read web:customers:read web:transactions:read web:interests:read',",
              "  iat: now,",
              "  exp: now + 900",
              "};",
              "const encodedHeader = base64url(JSON.stringify(header));",
              "const encodedPayload = base64url(JSON.stringify(payload));",
              "const toSign = encodedHeader + '.' + encodedPayload;",
              "const signature = CryptoJS.HmacSHA256(toSign, secret);",
              "const jwt = toSign + '.' + base64url(signature);",
              "",
              "pm.collectionVariables.set('webSessionJwt', jwt);"
            ]
          }
        }
      ],
