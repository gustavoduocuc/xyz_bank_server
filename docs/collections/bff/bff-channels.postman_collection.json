    {
      "name": "bff-mobile",
      "description": "Mobile channel on https://localhost:8082. The folder's pre-request script mints a dev-signed MOBILE device JWT bound to `{{deviceId}}` -- see the collection description for why this stands in for a real login here. Every request also sends `X-Device-Id`, which must match the token's bound device.",
      "variable": [
        { "key": "baseUrl", "value": "https://localhost:8082" }
      ],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Self-contained: mints a dev-signed MOBILE device JWT, matching",
              "// JwtCallerContextAdapter.issue(customerId, Channel.MOBILE, deviceId) exactly",
              "// (same claims, same HS256 signing secret). See the collection description.",
              "function base64url(wordArrayOrString) {",
              "  const wordArray = typeof wordArrayOrString === 'string'",
              "    ? CryptoJS.enc.Utf8.parse(wordArrayOrString)",
              "    : wordArrayOrString;",
              "  return CryptoJS.enc.Base64.stringify(wordArray)",
              "    .replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "}",
              "",
              "const secret = pm.collectionVariables.get('jwtSecret');",
              "const now = Math.floor(Date.now() / 1000);",
              "const header = { alg: 'HS256' };",
              "const payload = {",
              "  sub: pm.collectionVariables.get('customerId'),",
              "  channel: 'MOBILE',",
              "  scope: 'mobile:accounts:read mobile:transactions:read',",
              "  iat: now,",
              "  exp: now + 900,",
              "  terminalId: pm.collectionVariables.get('deviceId')",
              "};",
              "const encodedHeader = base64url(JSON.stringify(header));",
              "const encodedPayload = base64url(JSON.stringify(payload));",
              "const toSign = encodedHeader + '.' + encodedPayload;",
              "const signature = CryptoJS.HmacSHA256(toSign, secret);",
              "const jwt = toSign + '.' + base64url(signature);",
              "",
              "pm.collectionVariables.set('mobileDeviceJwt', jwt);"
            ]
          }
        }
      ],
      "item": [
        {
          "name": "⚠️ REFERENCE ONLY — GET start OIDC login",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/oauth2/authorization/oidc?deviceId={{deviceId}}",
