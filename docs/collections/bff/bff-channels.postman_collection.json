{
  "info": {
    "name": "XYZ Bank — BFFs",
    "description": "Happy-path requests for the three channel BFFs against the local compose stack (`docker compose up --build`). Identity is header-based (`X-Customer-Id`, `X-Channel`, and `X-Terminal-Id` on ATM). Demo IDs match Flyway `V6__seed_demo_data.sql` / the root README. Import this file in Postman and run a folder or the whole collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "customerId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "accountId", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "unknownId", "value": "99999999-9999-9999-9999-999999999999" },
    { "key": "interestYear", "value": "2025" },
    { "key": "from", "value": "2026-01-01" },
    { "key": "to", "value": "2026-01-31" },
    { "key": "type", "value": "DEBIT" },
    { "key": "pageSize", "value": "10" },
    { "key": "terminalId", "value": "ATM-001" },
    { "key": "idempotencyKey", "value": "demo-withdrawal-1" },
    { "key": "withdrawalAmount", "value": "40.00" },
    { "key": "withdrawalCurrency", "value": "USD" },
    { "key": "correlationId", "value": "postman-bff-demo" }
  ],
  "item": [
    {
      "name": "bff-web",
      "description": "Web channel on http://localhost:8081. Requires `X-Channel: web`. Payloads are full dashboard / history / interest views.",
      "variable": [
        { "key": "baseUrl", "value": "http://localhost:8081" },
        { "key": "channel", "value": "web" }
      ],
      "item": [
        {
          "name": "GET dashboard",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('profile matches demo customer', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.profile.id).to.eql(pm.collectionVariables.get('customerId'));",
                  "  pm.expect(body.accounts).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Customer-Id", "value": "{{customerId}}" },
              { "key": "X-Channel", "value": "{{channel}}" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "url": "{{baseUrl}}/customers/{{customerId}}/dashboard"
          }
        },
        {
          "name": "GET transaction history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('returns transaction items', function () {",
                  "  pm.expect(pm.response.json().items).to.be.an('array').that.is.not.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Customer-Id", "value": "{{customerId}}" },
              { "key": "X-Channel", "value": "{{channel}}" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/transactions"
          }
        },
        {
          "name": "GET transaction history (filtered)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('items are DEBIT in the demo January window', function () {",
                  "  const items = pm.response.json().items;",
                  "  pm.expect(items).to.be.an('array').that.is.not.empty;",
                  "  items.forEach(function (item) { pm.expect(item.type).to.eql('DEBIT'); });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Customer-Id", "value": "{{customerId}}" },
              { "key": "X-Channel", "value": "{{channel}}" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/transactions?from={{from}}&to={{to}}&type={{type}}&pageSize={{pageSize}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "transactions"],
              "query": [
                { "key": "from", "value": "{{from}}" },
                { "key": "to", "value": "{{to}}" },
                { "key": "type", "value": "{{type}}" },
                { "key": "pageSize", "value": "{{pageSize}}" },
                { "key": "cursor", "value": "", "disabled": true }
              ]
            }
          }
        },
        {
          "name": "GET interest summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('summary is the 2025 demo row', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accountId).to.eql(pm.collectionVariables.get('accountId'));",
                  "  pm.expect(String(body.year)).to.eql(pm.collectionVariables.get('interestYear'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Customer-Id", "value": "{{customerId}}" },
              { "key": "X-Channel", "value": "{{channel}}" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/accounts/{{accountId}}/interest-summary?year={{interestYear}}",
              "host": ["{{baseUrl}}"],
              "path": ["accounts", "{{accountId}}", "interest-summary"],
              "query": [
                { "key": "year", "value": "{{interestYear}}" }
              ]
            }
          }
        },
        {
          "name": "GET health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('service is UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": "No identity headers. Used by compose healthchecks."
          }
        },
        {
          "name": "GET OpenAPI",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('body looks like OpenAPI', function () {",
                  "  pm.expect(pm.response.text()).to.match(/openapi:/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v3/api-docs",
            "description": "Checked-in contract. No identity headers."
          }
        }
      ]
    },
    {
      "name": "bff-mobile",
      "description": "Mobile channel on http://localhost:8082. Requires `X-Channel: mobile`. Payload is a small account summary.",
      "variable": [
        { "key": "baseUrl", "value": "http://localhost:8082" },
        { "key": "channel", "value": "mobile" }
      ],
      "item": [
        {
          "name": "GET account summary",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('summary has balance and at most 5 transactions', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.currency).to.eql('USD');",
                  "  pm.expect(body.transactions).to.be.an('array');",
                  "  pm.expect(body.transactions.length).to.be.at.most(5);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Customer-Id", "value": "{{customerId}}" },
              { "key": "X-Channel", "value": "{{channel}}" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/summary"
          }
        },
        {
          "name": "GET health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('service is UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": "No identity headers. Used by compose healthchecks."
          }
        },
        {
          "name": "GET OpenAPI",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('body looks like OpenAPI', function () {",
                  "  pm.expect(pm.response.text()).to.match(/openapi:/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v3/api-docs",
            "description": "Checked-in contract. No identity headers."
          }
        }
      ]
    },
    {
      "name": "bff-atm",
      "description": "ATM channel on http://localhost:8083. Requires `X-Channel: atm` and `X-Terminal-Id`. Withdrawals also need `Idempotency-Key`. Re-running the withdrawal request with the same key replays the original result.",
      "variable": [
        { "key": "baseUrl", "value": "http://localhost:8083" },
        { "key": "channel", "value": "atm" }
      ],
      "item": [
        {
          "name": "GET balance",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('balance payload has currency', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.currency).to.eql('USD');",
                  "  pm.expect(body.balance).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "X-Customer-Id", "value": "{{customerId}}" },
              { "key": "X-Channel", "value": "{{channel}}" },
              { "key": "X-Terminal-Id", "value": "{{terminalId}}" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "url": "{{baseUrl}}/accounts/{{accountId}}/balance"
          }
        },
        {
          "name": "POST withdrawal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('withdrawal result has transactionId and newBalance', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.accountId).to.eql(pm.collectionVariables.get('accountId'));",
                  "  pm.expect(body.transactionId).to.be.a('string').that.is.not.empty;",
                  "  pm.expect(body.newBalance).to.exist;",
                  "  pm.collectionVariables.set('lastWithdrawalTransactionId', body.transactionId);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Customer-Id", "value": "{{customerId}}" },
              { "key": "X-Channel", "value": "{{channel}}" },
              { "key": "X-Terminal-Id", "value": "{{terminalId}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{withdrawalAmount}},\n  \"currency\": \"{{withdrawalCurrency}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/withdrawals",
            "description": "Uses the same Idempotency-Key as the retry request. First successful commit is stored; later calls with this key replay that result (201) instead of withdrawing again."
          }
        },
        {
          "name": "POST withdrawal (idempotent retry)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('replays the same transactionId when the key is reused', function () {",
                  "  const previousId = pm.collectionVariables.get('lastWithdrawalTransactionId');",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.transactionId).to.be.a('string').that.is.not.empty;",
                  "  if (previousId) {",
                  "    pm.expect(body.transactionId).to.eql(previousId);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Customer-Id", "value": "{{customerId}}" },
              { "key": "X-Channel", "value": "{{channel}}" },
              { "key": "X-Terminal-Id", "value": "{{terminalId}}" },
              { "key": "Idempotency-Key", "value": "{{idempotencyKey}}" },
              { "key": "X-Correlation-Id", "value": "{{correlationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {{withdrawalAmount}},\n  \"currency\": \"{{withdrawalCurrency}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/accounts/{{accountId}}/withdrawals",
            "description": "Same body and Idempotency-Key as POST withdrawal. Expect 201 with the originally committed result."
          }
        },
        {
          "name": "GET health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('service is UP', function () { pm.expect(pm.response.json().status).to.eql('UP'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health",
            "description": "No identity headers. Used by compose healthchecks."
          }
        },
        {
          "name": "GET OpenAPI",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('body looks like OpenAPI', function () {",
                  "  pm.expect(pm.response.text()).to.match(/openapi:/i);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/v3/api-docs",
            "description": "Checked-in contract. No identity headers."
          }
        }
      ]
    }
  ]
}
