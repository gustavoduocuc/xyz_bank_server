    {
      "name": "bff-atm",
      "description": "ATM channel on https://localhost:8083. Requires the terminal's mTLS client certificate on every request (configure it once in Postman's Settings > Certificates -- see the collection description). Run \"POST verify pin\" first: it captures the real 120-second session core-service issues into {{atmSessionToken}}, which every other request in this folder uses as its Bearer token. If a later request returns 422, the session has expired -- rerun \"POST verify pin\".",
      "variable": [
        { "key": "baseUrl", "value": "https://localhost:8083" }
      ],
      "item": [
        {
          "name": "POST verify pin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('issues a session token', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.sessionToken).to.be.a('string').that.is.not.empty;",
                  "  pm.collectionVariables.set('atmSessionToken', body.sessionToken);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardNumber\": \"{{cardNumber}}\",\n  \"pin\": \"{{cardPin}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/pin-verifications",
            "description": "Verifies the seeded demo card's PIN and issues a genuine 120-second session bound to this terminal's certificate. No Bearer token needed for this one request -- it's what produces one."
          }
        },
        {
          "name": "POST verify pin (wrong pin -> 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 401', function () { pm.response.to.have.status(401); });",
                  "pm.test('no pin leaked in the response body', function () {",
                  "  pm.expect(pm.response.text()).to.not.include('9999');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cardNumber\": \"{{cardNumber}}\",\n  \"pin\": \"9999\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/pin-verifications",
            "description": "Run this at most twice in a row without also running \"POST verify pin\" successfully in between -- a third consecutive failure locks the demo card (423 afterwards, even with the correct PIN). Unlock it with scripts/reset-dev-card-lock.sh."
          }
        },
        {
          "name": "GET balance",
