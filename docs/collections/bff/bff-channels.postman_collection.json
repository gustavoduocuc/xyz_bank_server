        {
          "name": "POST withdrawal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201', function () { pm.response.to.have.status(201); });",
                  "pm.test('withdrawal result has transactionId and newBalance', function () {",
                  "  const body = pm.response.json();",
