    {
      "name": "interests-service",
      "description": "Plain-HTTP smoke for Config Server (:8888), Eureka (:8761), and interests-service (:8084). Run after `docker compose up --build`. Apply uses `{{applyYear}}` (default 2026) because the demo seed already has year 2025. GET interest-summary forwards a minted WEB Bearer to core; POST interest-applications authenticates to core with the interests service JWT issued inside the service.",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Mint a WEB JWT for summary GETs that forward Authorization to core-service.",
              "function base64url(wordArrayOrString) {",
              "  const wordArray = typeof wordArrayOrString === 'string'",
              "    ? CryptoJS.enc.Utf8.parse(wordArrayOrString)",
              "    : wordArrayOrString;",
              "  return CryptoJS.enc.Base64.stringify(wordArray)",
              "    .replace(/=+$/, '').replace(/\\+/g, '-').replace(/\\//g, '_');",
              "}",
              "",
              "const secret = pm.collectionVariables.get('jwtSecret');",
              "const now = Math.floor(Date.now() / 1000);",
              "const header = { alg: 'HS256' };",
              "const payload = {",
              "  sub: pm.collectionVariables.get('customerId'),",
              "  channel: 'WEB',",
              "  scope: 'web:accounts:read web:customers:read web:transactions:read web:interests:read',",
              "  iat: now,",
              "  exp: now + 900",
              "};",
              "const encodedHeader = base64url(JSON.stringify(header));",
              "const encodedPayload = base64url(JSON.stringify(payload));",
              "const toSign = encodedHeader + '.' + encodedPayload;",
              "const signature = CryptoJS.HmacSHA256(toSign, secret);",
              "pm.collectionVariables.set('webBearerJwt', toSign + '.' + base64url(signature));"
            ]
          }
        }
      ],
